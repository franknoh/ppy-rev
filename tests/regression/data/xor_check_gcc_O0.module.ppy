"""PPy lifted from xor_check_gcc_O0 (x86-64) by ppy-rev."""

from ppy import u8, u16, u32, u64

from runtime import (
    Machine,
    Region,
    arithmetic_shift_right,
    count_leading_zeros,
    popcount,
    sign_extend,
    signed,
    signed_borrow,
    signed_carry,
    signed_div,
    signed_rem,
)


def check(m: Machine, rcx: u64, rdx: u64, rsp: u64, rbp: u64, rsi: u64, rdi: u64) -> tuple[u64, u64, u64, u64, u64, u64]:
    """check @ 0x101169; returns (RAX, RCX, RDX, RSP, RBP, RSI)."""
    v6: u64 = 0
    v7: u64 = 0
    v8: u64 = 0
    v9: u64 = 0
    v10: u64 = 0
    v11: u64 = 0
    v12: u64 = 0
    v13: u64 = 0
    v14: u8 = 0
    v15: u64 = 0
    v16: u64 = 0
    v17: u64 = 0
    v18: u64 = 0
    v19: u8 = 0
    v20: u32 = 0
    v21: u32 = 0
    v22: u64 = 0
    v23: u64 = 0
    v24: u8 = 0
    v25: u8 = 0
    v26: u8 = 0
    v27: u8 = 0
    v28: u64 = 0
    v29: u64 = 0
    v30: u64 = 0
    v31: u64 = 0
    v32: u64 = 0
    v33: u8 = 0
    v34: u64 = 0
    v35: u8 = 0
    v36: u8 = 0
    v37: u64 = 0
    v38: u64 = 0
    v39: u64 = 0
    v40: u64 = 0
    v41: u64 = 0
    v42: u64 = 0
    block: int = 0
    while True:
        if block == 0:  # 0x10116d
            v6 = (rsp - 8) & 0xffffffffffffffff
            m.memory.store(v6, 8, rbp)
            v7 = (rsp - 0x20) & 0xffffffffffffffff
            m.memory.store(v7, 8, rdi)
            v8 = (rsp - 0x30) & 0xffffffffffffffff
            m.memory.store(v8, 8, 0x101185)
            results1 = m.external('strlen', {"RAX": rdi, "RCX": rcx, "RDX": rdx, "RSP": v8, "RSI": rsi, "RDI": rdi})  # 0x101180
            v9 = results1.get("RAX", 0) & 0xffffffffffffffff
            v10 = results1.get("RCX", 0) & 0xffffffffffffffff
            v11 = results1.get("RDX", 0) & 0xffffffffffffffff
            v12 = results1.get("RSI", 0) & 0xffffffffffffffff
            v13 = (v9 - 0xb) & 0xffffffffffffffff
            v14 = 1 if v13 == 0 else 0
            if v14 != 0:
                block = 2
            else:
                block = 1
        elif block == 1:  # 0x10118b
            v37, v38, v39 = 0, v10, v11
            block = 8
        elif block == 2:  # 0x101192
            v15 = (rsp - 0x10) & 0xffffffffffffffff
            m.memory.store(v15, 8, 0)
            v30, v31 = v10, v11
            block = 6
        elif block == 3:  # 0x10119c
            v16 = m.memory.load_u64(v7)
            v17 = m.memory.load_u64(v15)
            v18 = (v17 + v16) & 0xffffffffffffffff
            v19 = m.memory.load_u8(v18)
            v20 = v19
            v21 = v20 ^ 0x42
            v22 = v21
            v23 = (v17 + 0x102008) & 0xffffffffffffffff
            v24 = m.memory.load_u8(v23)
            v25 = v19 ^ 0x42
            v26 = (v25 - v24) & 0xff
            v27 = 1 if v26 == 0 else 0
            if v27 != 0:
                block = 5
            else:
                block = 4
        elif block == 4:  # 0x1011c4
            v37, v38, v39 = 0, 0x102008, v22
            block = 8
        elif block == 5:  # 0x1011cb
            v28 = m.memory.load_u64(v15)
            v29 = (v28 + 1) & 0xffffffffffffffff
            m.memory.store(v15, 8, v29)
            v30, v31 = 0x102008, v22
            block = 6
        elif block == 6:  # 0x1011d0
            v32 = m.memory.load_u64(v15)
            v33 = 1 if v32 < 0xa else 0
            v34 = (v32 - 0xa) & 0xffffffffffffffff
            v35 = 1 if v34 == 0 else 0
            v36 = v33 | v35
            if v36 != 0:
                block = 3
            else:
                block = 7
        elif block == 7:  # 0x1011d7
            v37, v38, v39 = 1, v30, v31
            block = 8
        elif block == 8:  # 0x1011dc
            v40 = m.memory.load_u64(v6)
            v41 = m.memory.load_u64(rsp)
            v42 = (rsp + 8) & 0xffffffffffffffff
            return (v37, v38, v39, v42, v40, v12)
        else:
            raise AssertionError("unknown block")


def main(m: Machine, rcx: u64, rdx: u64, rsp: u64, rbp: u64, rsi: u64, rdi: u64) -> tuple[u64, u64, u64, u64]:
    """main @ 0x1011de; returns (RAX, RDX, RSP, RBP)."""
    v6: u64 = 0
    v7: u64 = 0
    v8: u64 = 0
    v9: u32 = 0
    v10: u32 = 0
    v11: u8 = 0
    v12: u64 = 0
    v13: u64 = 0
    v14: u64 = 0
    v15: u64 = 0
    v16: u64 = 0
    v17: u64 = 0
    v18: u64 = 0
    v19: u64 = 0
    v20: u64 = 0
    v21: u64 = 0
    v22: u64 = 0
    v23: u64 = 0
    v24: u32 = 0
    v25: u8 = 0
    v26: u64 = 0
    v27: u64 = 0
    v28: u64 = 0
    v29: u64 = 0
    v30: u64 = 0
    v31: u64 = 0
    v32: u64 = 0
    v33: u64 = 0
    v34: u64 = 0
    v35: u64 = 0
    v36: u64 = 0
    block: int = 0
    while True:
        if block == 0:  # 0x1011e2
            v6 = (rsp - 8) & 0xffffffffffffffff
            m.memory.store(v6, 8, rbp)
            v7 = (rsp - 0x18) & 0xffffffffffffffff
            v8 = (rsp - 0xc) & 0xffffffffffffffff
            v9 = rdi & 0xffffffff
            m.memory.store(v8, 4, v9)
            m.memory.store(v7, 8, rsi)
            v10 = (v9 - 2) & 0xffffffff
            v11 = 1 if v10 == 0 else 0
            if v11 != 0:
                block = 2
            else:
                block = 1
        elif block == 1:  # 0x1011f7
            v12 = (rsp - 0x20) & 0xffffffffffffffff
            m.memory.store(v12, 8, 0x101206)
            results1 = m.external('puts', {"RAX": 0x102013, "RCX": rcx, "RDX": rdx, "RSP": v12, "RSI": rsi, "RDI": 0x102013})  # 0x101201
            v13 = results1.get("RDX", 0) & 0xffffffffffffffff
            v30, v31, v32 = 2, v13, v6
            block = 5
        elif block == 2:  # 0x10120d
            v14 = m.memory.load_u64(v7)
            v15 = (v14 + 8) & 0xffffffffffffffff
            v16 = m.memory.load_u64(v15)
            v17 = (rsp - 0x20) & 0xffffffffffffffff
            m.memory.store(v17, 8, 0x101220)
            (v18, v19, v20, v21, v22, v23) = check(m, rcx, rdx, v17, v6, rsi, v16)  # 0x10121b
            v24 = v18 & 0xffffffff
            v25 = 1 if v24 == 0 else 0
            if v25 != 0:
                block = 4
            else:
                block = 3
        elif block == 3:  # 0x101224
            v26 = (v21 - 8) & 0xffffffffffffffff
            m.memory.store(v26, 8, 0x101233)
            results2 = m.external('puts', {"RAX": 0x10202c, "RCX": v19, "RDX": v20, "RSP": v26, "RSI": v23, "RDI": 0x10202c})  # 0x10122e
            v27 = results2.get("RDX", 0) & 0xffffffffffffffff
            v30, v31, v32 = 0, v27, v22
            block = 5
        elif block == 4:  # 0x10123a
            v28 = (v21 - 8) & 0xffffffffffffffff
            m.memory.store(v28, 8, 0x101249)
            results3 = m.external('puts', {"RAX": 0x102035, "RCX": v19, "RDX": v20, "RSP": v28, "RSI": v23, "RDI": 0x102035})  # 0x101244
            v29 = results3.get("RDX", 0) & 0xffffffffffffffff
            v30, v31, v32 = 1, v29, v22
            block = 5
        elif block == 5:  # 0x10124e
            v33 = m.memory.load_u64(v32)
            v34 = (v32 + 8) & 0xffffffffffffffff
            v35 = m.memory.load_u64(v34)
            v36 = (v32 + 0x10) & 0xffffffffffffffff
            return (v30, v31, v36, v33)
        else:
            raise AssertionError("unknown block")


def regions() -> list[Region]:
    """The program image."""
    return [
        Region('.rodata', 0x102000, 0x3c, False,
            b"\x01\x00\x02\x00\x00\x00\x00\x000'4\x1d+1\x1d'#1;usage: xor_ch"
            b'eck <input>\x00Correct!\x00Wrong!\x00'
        ),
    ]


def new_machine() -> Machine:
    return Machine(regions())
