def regions() -> list[Region]:
    """The program image."""
    return [
        Region('.rodata', 0x102000, 0x3c, False,
            b"\x01\x00\x02\x00\x00\x00\x00\x000'4\x1d+1\x1d'#1;usage: xor_ch"
            b'eck <input>\x00Correct!\x00Wrong!\x00'
        ),
    ]


def new_machine() -> Machine:
    return Machine(regions())
