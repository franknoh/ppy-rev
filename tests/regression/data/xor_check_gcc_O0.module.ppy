    block: int = 0
    while True:
        if block == 0:  # 0x10116d
            v6 = (rsp - 8) & 0xffffffffffffffff
            m.memory.store(v6, 8, rbp)
            v7 = (rsp - 0x20) & 0xffffffffffffffff
            m.memory.store(v7, 8, rdi)
            v8 = (rsp - 0x30) & 0xffffffffffffffff
            m.memory.store(v8, 8, 0x101185)
            results1 = m.external('strlen', {"RAX": rdi, "RCX": rcx, "RDX": rdx, "RSP": v8, "RSI": rsi, "RDI": rdi})  # 0x101180
            v9 = results1["RAX"] & 0xffffffffffffffff
            v10 = results1["RCX"] & 0xffffffffffffffff
            v11 = results1["RDX"] & 0xffffffffffffffff
            v12 = results1["RSP"] & 0xffffffffffffffff
            v13 = results1["RSI"] & 0xffffffffffffffff
            v14 = results1["RDI"] & 0xffffffffffffffff
            v15 = results1["CF"] & 0xff
            v16 = results1["PF"] & 0xff
            v17 = results1["ZF"] & 0xff
            v18 = results1["SF"] & 0xff
            v19 = results1["OF"] & 0xff
            v20 = (v9 - 0xb) & 0xffffffffffffffff
            v21 = 1 if v20 == 0 else 0
            if v21 != 0:
                block = 2
            else:
                block = 1
        elif block == 1:  # 0x10118b
            v44, v45, v46 = 0, v10, v11
            block = 8
        elif block == 2:  # 0x101192
            v22 = (rsp - 0x10) & 0xffffffffffffffff
            m.memory.store(v22, 8, 0)
            v37, v38 = v10, v11
            block = 6
        elif block == 3:  # 0x10119c
            v23 = m.memory.load_u64(v7)
            v24 = m.memory.load_u64(v22)
            v25 = (v24 + v23) & 0xffffffffffffffff
            v26 = m.memory.load_u8(v25)
            v27 = v26
            v28 = v27 ^ 0x42
            v29 = v28
            v30 = (v24 + 0x102008) & 0xffffffffffffffff
            v31 = m.memory.load_u8(v30)
            v32 = v26 ^ 0x42
            v33 = (v32 - v31) & 0xff
            v34 = 1 if v33 == 0 else 0
            if v34 != 0:
                block = 5
            else:
                block = 4
        elif block == 4:  # 0x1011c4
            v44, v45, v46 = 0, 0x102008, v29
            block = 8
        elif block == 5:  # 0x1011cb
            v35 = m.memory.load_u64(v22)
            v36 = (v35 + 1) & 0xffffffffffffffff
            m.memory.store(v22, 8, v36)
            v37, v38 = 0x102008, v29
            block = 6
        elif block == 6:  # 0x1011d0
            v39 = m.memory.load_u64(v22)
            v40 = 1 if v39 < 0xa else 0
            v41 = (v39 - 0xa) & 0xffffffffffffffff
            v42 = 1 if v41 == 0 else 0
            v43 = v40 | v42
            if v43 != 0:
                block = 3
            else:
                block = 7
        elif block == 7:  # 0x1011d7
            v44, v45, v46 = 1, v37, v38
            block = 8
        elif block == 8:  # 0x1011dc
            v47 = m.memory.load_u64(v6)
            v48 = m.memory.load_u64(rsp)
            v49 = (rsp + 8) & 0xffffffffffffffff
            return (v44, v45, v46, v49, v47, v13)
        else:
            raise AssertionError("unknown block")


